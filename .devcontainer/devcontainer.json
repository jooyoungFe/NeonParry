{
  "name": "Neon Parry server",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Neon Parry game + duel API",
      "protocol": "http",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "node scripts/codespaces.cjs"
}
